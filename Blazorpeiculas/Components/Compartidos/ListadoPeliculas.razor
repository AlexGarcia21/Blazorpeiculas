@using Blazorpeiculas.Utilidades
@inject IJSRuntime JS

<div class="m-4">
    <div class="row g-4 text-center">
        <ListadoGenerico Listado="Peliculas">
            <ErrorBoundary>
                <ChildContent>
                    <div class=" col-6 col-sm-4 col-md-3 col-lg-2">
                        <div class="h-100">
                            <PeliculaIndividual Pelicula="context" @key="context.Id" />
                        </div>
                    </div>

                </ChildContent>
                <ErrorContent Context="error">
                    <div class=" col-6 col-sm-4 col-md-3 col-lg-2">
                        <div class="h-100">
                            <div class="card-body p2">
                                <div calss="fw-semibold">
                                    Error mostrando la pelicula...
                                </div>
                            </div>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </ListadoGenerico>

</div>

</div>



@code {
    [Parameter] public List<Pelicula>? Peliculas { get; set; }
}