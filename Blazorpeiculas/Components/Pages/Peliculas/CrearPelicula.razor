@page "/peliculas/crear"
@using Blazorpeiculas.Components.Pages.Actores
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<h3>CrearPelicula</h3>

<FormularioPelicula FormularioPosteadoConExito="formularioPosteadoConExito"
    PosteoEnCurso="posteoEnCurso"
    OnValidSubmit="Crear" Pelicula="pelicula"
    GenerosNoSeleccionados="GenerosNoSeleccionados"
    />

@code {
    private bool formularioPosteadoConExito = false;
    private bool posteoEnCurso = false;
    private Pelicula pelicula = null!;
    private List<Generos> GenerosNoSeleccionados = new List<Generos>();
    protected override void OnInitialized()
    {
        pelicula = new();

        GenerosNoSeleccionados = new List<Generos>()
    {
        new Generos(){Id = 1, Nombre = "Comedia"},
        new Generos(){Id = 2, Nombre = "Drama"},
        new Generos(){Id = 3, Nombre = "Acción"},
        new Generos(){Id = 4, Nombre = "Sci-fi"},
    };
    }

    private async Task Crear()
    {
        if (!posteoEnCurso)
        {
            posteoEnCurso = true;
            Console.WriteLine("Ejecutando método Crear");
            await Task.Delay(2000);
            Console.WriteLine($"Titulo: {pelicula.Titulo}");
            Console.WriteLine($"Fecha de lanzamiento: {pelicula.FechaLanzamiento}");
            Console.WriteLine($"¿Hay imagen?: {pelicula.PosterArchivo is not null}");
            Console.WriteLine($"En cartelera: {pelicula.EnCartelera}");

            Console.WriteLine("--Generos--");
            pelicula.GenerosPeliculas.ForEach(x => Console.WriteLine(x.GeneroId));

            posteoEnCurso = false;
            formularioPosteadoConExito = true;
            StateHasChanged();
            navigationManager.NavigateTo("/peliculas");
        }
    }
}
