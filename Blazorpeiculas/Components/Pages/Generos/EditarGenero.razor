@page "/generos/editar/{Id:int}"
@inject NavigationManager navigationManager
@inject IServiciosGeneros serviciosGeneros
<h3>EditarGenero</h3>

@if(generos is null)
{
    <Cargando />
}else{
<FormularioGenero FormularioPosteadoConExito="FormularioPosteadoConExito"
                  PosteoEnCurso="PosteoEnCurso"
              FormularioInvalido="false"    OnValidSubmit="Editar" Generos="generos" />
}

@code {
    [Parameter] public int Id { get; set; }
    private Generos? generos = null;
    private bool FormularioPosteadoConExito = false;
    private bool PosteoEnCurso = false;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}
		generos = await serviciosGeneros.ObtenerPorId(Id);

		if (generos is null)
		{
			navigationManager.NavigateTo("/generos");
		}

		StateHasChanged();
	}  

    private async Task Editar()
    {
        if (!PosteoEnCurso)
        {
            PosteoEnCurso = true;
           
			StateHasChanged();
			await Task.Yield();

			await serviciosGeneros.Actualizar(generos!); 


            PosteoEnCurso = false;
            FormularioPosteadoConExito = true;
            StateHasChanged();
            navigationManager.NavigateTo("/Generos");
        }

    }
}
