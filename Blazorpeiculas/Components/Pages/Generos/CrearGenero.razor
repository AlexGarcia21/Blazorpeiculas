@page "/generos/crear"
@using Blazorpeiculas.Datos
@using Blazorpeiculas.Utilidades
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject IServiciosGeneros serviciosGeneros
@inject NavigationManager navigationManager
@attribute [Authorize(Roles = "administrador")]
<h3>Crear Genero</h3>

<FormularioGenero FormularioPosteadoConExito="formularioPosteadoConExito"
    PosteoEnCurso="posteoEnCurso"
    OnValidSubmit="Crear" Generos="genero" />


@code {
    private Generos genero = null!;

    private bool posteoEnCurso = false;
    private bool formularioPosteadoConExito = false;


    protected override void OnInitialized()
    {
        genero = new Generos();
    }


    private async Task Crear()
    {
        if (!posteoEnCurso)
        {
            posteoEnCurso = true;
            StateHasChanged();
            await Task.Yield();

			await serviciosGeneros.Crear(genero);


            posteoEnCurso = false;
            formularioPosteadoConExito = true;
			StateHasChanged();
            navigationManager.NavigateTo("/Generos");
        }

    }
   

    
    }

    
